# Copy only to the production server as /etc/telegram-kol-oncall.env.
# The real file must be root-owned mode 0600 and must never be committed.
# The bot token is read once at start and is never logged, never written to
# the watcher's state database, and never included in an error message.

# off | dry_run | notify. Absent or "off" makes the process exit immediately.
TELEGRAM_KOL_ONCALL_MODE=off

# Leave both empty to reuse the existing system operator bot: the unit also
# loads config/system_operator_bot.env and the watcher falls back to
# TELEGRAM_KOL_SYSTEM_BOT_TOKEN / TELEGRAM_KOL_SYSTEM_BOT_CHAT_ID. The watcher
# still sends from its own process, so it can speak when the worker cannot.
# Set these two only to route on-call alerts to a different bot or chat.
# In notify mode with no token from either source the process exits 78.
TELEGRAM_KOL_ONCALL_BOT_TOKEN=
TELEGRAM_KOL_ONCALL_CHAT_ID=

# Optional. Leave empty to skip the worker loop-health check (rule D5b).
TELEGRAM_KOL_ONCALL_WORKER_HEALTH_URL=http://127.0.0.1:8002/api/runtime/loop-health

# Alerts per Beijing day before the watcher falls back to one "cap reached"
# notice. The daily "watch is fine" message is never capped.
TELEGRAM_KOL_ONCALL_DAILY_ALERT_CAP=30

# --- phase 2: Codex diagnosis (explains, never acts) ---
# off | shadow | on. Absent or "off" means the watcher behaves exactly as it
# did in phase 1: no case file is exported, the spool is never touched, and no
# token is spent. "shadow" calls Codex and stores the verdict but sends no
# diagnosis message; "on" also sends it. A dry-run watcher treats "on" as
# "shadow". This file is read by both units, so both must agree.
TELEGRAM_KOL_ONCALL_CODEX_MODE=off

# Where the unprivileged watcher and the root-side runner meet. Must be inside
# the watcher's StateDirectory, and root:telegram-kol-oncall mode 2770.
TELEGRAM_KOL_ONCALL_CODEX_SPOOL=/var/lib/telegram-kol-oncall/codex-spool

# Codex calls per Beijing day, across all cases. Beyond it a case is marked
# "diagnosis_skipped:daily_cap" and its opening alert says so.
TELEGRAM_KOL_ONCALL_CODEX_DAILY_CAP=20

# Only if the codex executable is somewhere other than /usr/local/bin/codex.
# Read by the runner unit; never passed to the codex child process.
# TELEGRAM_KOL_ONCALL_CODEX_BIN=/usr/local/bin/codex
