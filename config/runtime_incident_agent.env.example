# Copy only to the production server as config/runtime_incident_agent.env.
# The real file must be root-owned mode 0600 and must never be committed.

TELEGRAM_KOL_RUNTIME_AGENT_LLM_BASE_URL=https://api.xiaomimimo.com/v1
TELEGRAM_KOL_RUNTIME_AGENT_LLM_API_KEY=
TELEGRAM_KOL_RUNTIME_AGENT_LLM_MODEL=mimo-v2.5
TELEGRAM_KOL_RUNTIME_AGENT_LLM_TIMEOUT_SECONDS=30

# Dormant rollout defaults.
TELEGRAM_KOL_RUNTIME_AGENT_ENABLED=false
TELEGRAM_KOL_RUNTIME_AGENT_SHADOW_PLAYBOOKS=
TELEGRAM_KOL_RUNTIME_AGENT_ACTIONS_ENABLED=false
TELEGRAM_KOL_RUNTIME_AGENT_ACTION_PLAYBOOKS=
TELEGRAM_KOL_RUNTIME_AGENT_ACTION_CIRCUIT_THRESHOLD=3
