#!/usr/bin/env bash
set -euo pipefail

DEPLOYMENT_ACTION="${DEPLOYMENT_ACTION:?DEPLOYMENT_ACTION=activate is required}"
if [ "$DEPLOYMENT_ACTION" != "activate" ]; then
  echo "DEPLOYMENT_ACTION=activate is required; stage uses telegram-kol-stage." >&2
  exit 4
fi
if [[ ! "${ROLLBACK_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "ROLLBACK_COMMIT must identify the reviewed immutable control release." >&2
  exit 4
fi

DISPATCHER_RELEASE_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
if [ "$(basename -- "$DISPATCHER_RELEASE_ROOT")" != "$ROLLBACK_COMMIT" ]; then
  echo "Dispatcher release identity does not match ROLLBACK_COMMIT." >&2
  exit 4
fi
ACTIVATOR_PATH="$DISPATCHER_RELEASE_ROOT/deploy/telegram-kol-activate"
if [ ! -x "$ACTIVATOR_PATH" ]; then
  echo "Scoped activator is unavailable." >&2
  exit 4
fi
exec "$ACTIVATOR_PATH"
