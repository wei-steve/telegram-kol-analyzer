#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/telegram-kol-analyzer}"
BRANCH="${BRANCH:-codex/deepcoin-auto-trading-v1}"
EXPECTED_COMMIT="${EXPECTED_COMMIT:?set EXPECTED_COMMIT to the reviewed 40-character commit}"
DATABASE_PATH="${DATABASE_PATH:-$APP_DIR/data/research.db}"
BACKUP_DIR="${BACKUP_DIR:-$APP_DIR/data/backups}"
STOP_TIMEOUT_SECONDS="${STOP_TIMEOUT_SECONDS:-30}"
UPDATER_PATH="${UPDATER_PATH:-/usr/local/bin/telegram-kol-update}"
LOCK_PATH="${LOCK_PATH:-/run/telegram-kol-update.lock}"
STAGE_PARENT="${STAGE_PARENT:-/run}"
monitor_env_override="${MONITOR_ENV_FILE:-}"
MONITOR_ENV_FILE="/etc/telegram-kol-monitor.env"
MONITOR_TIMER="telegram-kol-monitor.timer"
MONITOR_ONESHOT_UNITS=(
  "telegram-kol-monitor.service"
  "telegram-kol-monitor-diagnostic.service"
  "telegram-kol-monitor-test-notification.service"
)
MONOLITH_UNITS=("telegram-kol.service")
SPLIT_UNITS=(
  "telegram-kol-ingest.service"
  "telegram-kol-worker.service"
  "telegram-kol-web.service"
)
SPLIT_STOP_UNITS=(
  "telegram-kol-ingest.service"
  "telegram-kol-web.service"
  "telegram-kol-worker.service"
)
SPLIT_START_UNITS=(
  "telegram-kol-worker.service"
  "telegram-kol-web.service"
  "telegram-kol-ingest.service"
)
managed_topology=""
managed_stop_units=()
managed_start_units=()

resolve_managed_topology() {
  local monolith_active=0 split_installed=0 split_active=0 unit
  if systemctl is-active --quiet "${MONOLITH_UNITS[0]}"; then
    monolith_active=1
  fi
  for unit in "${SPLIT_UNITS[@]}"; do
    if systemctl cat "$unit" >/dev/null 2>&1; then
      split_installed=$((split_installed + 1))
    fi
    if systemctl is-active --quiet "$unit"; then
      split_active=$((split_active + 1))
    fi
  done

  if [ "$monolith_active" -eq 1 ] && [ "$split_active" -eq 0 ]; then
    managed_topology="monolith"
    managed_stop_units=("${MONOLITH_UNITS[@]}")
    managed_start_units=("${MONOLITH_UNITS[@]}")
    return 0
  fi
  if [ "$monolith_active" -eq 0 ] \
    && [ "$split_installed" -eq "${#SPLIT_UNITS[@]}" ] \
    && [ "$split_active" -eq "${#SPLIT_UNITS[@]}" ]; then
    managed_topology="split"
    managed_stop_units=("${SPLIT_STOP_UNITS[@]}")
    managed_start_units=("${SPLIT_START_UNITS[@]}")
    return 0
  fi
  echo "Ambiguous or incomplete runtime topology; refusing managed deployment." >&2
  return 1
}
if [ "${UPDATER_TEST_MODE:-0}" = "1" ]; then
  if [ "$APP_DIR" = "/opt/telegram-kol-analyzer" ] || [ -z "$monitor_env_override" ]; then
    echo "Updater test-mode path override is invalid." >&2
    exit 4
  fi
  MONITOR_ENV_FILE="$monitor_env_override"
fi
unset monitor_env_override

if [[ ! "$EXPECTED_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]]; then
  echo "EXPECTED_COMMIT must be a full 40-character hexadecimal commit." >&2
  exit 4
fi
EXPECTED_COMMIT="$(printf '%s' "$EXPECTED_COMMIT" | tr '[:upper:]' '[:lower:]')"
if [[ ! "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]]; then
  echo "BRANCH contains unsupported characters." >&2
  exit 4
fi
if [[ ! "$STOP_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "STOP_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 4
fi
if [ ! -d "$APP_DIR/.git" ] || [ ! -f "$DATABASE_PATH" ] || [ ! -x "$APP_DIR/.venv/bin/python" ]; then
  echo "Production checkout, database, or Python environment is unavailable." >&2
  exit 4
fi
if ! resolve_managed_topology; then
  exit 4
fi

exec 9>"$LOCK_PATH"
if ! flock -n 9; then
  echo "Another deployment is already running." >&2
  exit 4
fi

stage_dir=""
stage_registered=0
schema_backup=""
schema_dry_run=""
updater_backup=""
updater_candidate=""
stop_attempted=0
checkout_mutated=0
updater_installed=0
deployment_finalized=0
monitor_managed=0
monitor_state_captured=0
monitor_restore_needed=0
monitor_pin_normalized=0
monitor_timer_was_enabled=0
monitor_timer_was_active=0
if ! previous_commit="$(git -C "$APP_DIR" rev-parse HEAD)"; then
  echo "Could not read the production rollback commit." >&2
  exit 4
fi

wait_for_unit_inactive() {
  local unit="$1" remaining=$((STOP_TIMEOUT_SECONDS * 4)) state
  while true; do
    state="$(systemctl show "$unit" --property=ActiveState --value)" || return 1
    case "$state" in
      inactive|failed) return 0 ;;
    esac
    if [ "$remaining" -le 0 ]; then return 1; fi
    remaining=$((remaining - 1))
    sleep 0.25
  done
}

validate_monitor_env_file() {
  local metadata owner_uid mode extra_metadata expected_uid head_count head_line head_value
  if [ ! -f "$MONITOR_ENV_FILE" ] || [ -L "$MONITOR_ENV_FILE" ]; then
    return 1
  fi
  metadata="$(stat -c '%u %a' -- "$MONITOR_ENV_FILE")" || return 1
  read -r owner_uid mode extra_metadata <<<"$metadata"
  if [ -n "${extra_metadata:-}" ]; then return 1; fi
  expected_uid=0
  if [ "${UPDATER_TEST_MODE:-0}" = "1" ]; then
    expected_uid="$(id -u)"
  fi
  if [ "$owner_uid" != "$expected_uid" ] || [ "$mode" != "600" ]; then
    return 1
  fi
  head_count="$(grep -c '^TELEGRAM_KOL_MONITOR_EXPECTED_HEAD=' "$MONITOR_ENV_FILE" || true)"
  if [ "$head_count" != "1" ]; then return 1; fi
  head_line="$(grep '^TELEGRAM_KOL_MONITOR_EXPECTED_HEAD=' "$MONITOR_ENV_FILE")" || return 1
  head_value="${head_line#TELEGRAM_KOL_MONITOR_EXPECTED_HEAD=}"
  [[ "$head_value" =~ ^[0-9a-fA-F]{40}$ ]]
}

classify_monitor_installation() {
  local unit_present=0 env_present=0
  if systemctl cat "$MONITOR_TIMER" >/dev/null 2>&1; then
    unit_present=1
  fi
  if [ -e "$MONITOR_ENV_FILE" ] || [ -L "$MONITOR_ENV_FILE" ]; then
    env_present=1
  fi
  if [ "$unit_present" -eq 0 ] && [ "$env_present" -eq 0 ]; then
    monitor_managed=0
    return 0
  fi
  if [ "$unit_present" -ne 1 ] || [ "$env_present" -ne 1 ]; then
    return 1
  fi
  if ! validate_monitor_env_file; then return 1; fi
  monitor_managed=1
}

record_monitor_timer_state() {
  local enabled_state active_state enabled_status active_status
  set +e
  enabled_state="$(systemctl is-enabled "$MONITOR_TIMER" 2>/dev/null)"
  enabled_status=$?
  active_state="$(systemctl is-active "$MONITOR_TIMER" 2>/dev/null)"
  active_status=$?
  set -e
  case "$enabled_state:$enabled_status" in
    enabled:0) monitor_timer_was_enabled=1 ;;
    disabled:1) monitor_timer_was_enabled=0 ;;
    *) return 1 ;;
  esac
  case "$active_state:$active_status" in
    active:0) monitor_timer_was_active=1 ;;
    inactive:3) monitor_timer_was_active=0 ;;
    *) return 1 ;;
  esac
  monitor_state_captured=1
  monitor_restore_needed=1
}

wait_for_monitor_oneshots_inactive() {
  local remaining=$((STOP_TIMEOUT_SECONDS * 4)) unit state all_inactive
  while true; do
    all_inactive=1
    for unit in "${MONITOR_ONESHOT_UNITS[@]}"; do
      state="$(systemctl show "$unit" --property=ActiveState --value)" || return 1
      case "$state" in
        inactive|failed) ;;
        *) all_inactive=0 ;;
      esac
    done
    if [ "$all_inactive" -eq 1 ]; then return 0; fi
    if [ "$remaining" -le 0 ]; then return 1; fi
    remaining=$((remaining - 1))
    sleep 0.25
  done
}

stop_monitor_for_deployment() {
  local timer_state
  if ! systemctl stop "$MONITOR_TIMER"; then return 1; fi
  timer_state="$(systemctl show "$MONITOR_TIMER" --property=ActiveState --value)" || return 1
  case "$timer_state" in
    inactive|failed) ;;
    *) return 1 ;;
  esac
  wait_for_monitor_oneshots_inactive
}

sync_monitor_expected_head() {
  local target_commit="$1" candidate=""
  if [[ ! "$target_commit" =~ ^[0-9a-f]{40}$ ]]; then return 1; fi
  if ! validate_monitor_env_file; then return 1; fi
  candidate="$(mktemp "${MONITOR_ENV_FILE}.candidate.XXXXXX")" || return 1
  if ! "$APP_DIR/.venv/bin/python" -c '# monitor-pin-rewrite
import re
import sys
from pathlib import Path

source_path, candidate_path, target_commit = sys.argv[1:]
source = Path(source_path).read_bytes()
pattern = re.compile(
    br"(?m)^TELEGRAM_KOL_MONITOR_EXPECTED_HEAD=[^\r\n]*"
)
matches = pattern.findall(source)
if len(matches) != 1:
    raise SystemExit(4)
replacement = (
    b"TELEGRAM_KOL_MONITOR_EXPECTED_HEAD=" + target_commit.encode("ascii")
)
Path(candidate_path).write_bytes(pattern.sub(lambda _: replacement, source, count=1))
' "$MONITOR_ENV_FILE" "$candidate" "$target_commit"; then
    rm -f -- "$candidate"
    return 1
  fi
  if ! chmod 0600 "$candidate"; then
    rm -f -- "$candidate"
    return 1
  fi
  if [ "${UPDATER_TEST_MODE:-0}" != "1" ] && ! chown root:root "$candidate"; then
    rm -f -- "$candidate"
    return 1
  fi
  if ! mv -f -- "$candidate" "$MONITOR_ENV_FILE"; then
    rm -f -- "$candidate"
    return 1
  fi
  if ! validate_monitor_env_file; then return 1; fi
  grep -Fxq "TELEGRAM_KOL_MONITOR_EXPECTED_HEAD=$target_commit" "$MONITOR_ENV_FILE"
}

restore_monitor_timer_state() {
  local timer_state
  if [ "$monitor_timer_was_enabled" -eq 1 ]; then
    systemctl enable "$MONITOR_TIMER" || return 1
  else
    systemctl disable "$MONITOR_TIMER" || return 1
  fi
  if [ "$monitor_timer_was_active" -eq 1 ]; then
    systemctl start "$MONITOR_TIMER" || return 1
    timer_state="$(systemctl show "$MONITOR_TIMER" --property=ActiveState --value)" || return 1
    [ "$timer_state" = "active" ] || return 1
  else
    timer_state="$(systemctl show "$MONITOR_TIMER" --property=ActiveState --value)" || return 1
    case "$timer_state" in
      inactive|failed) ;;
      *) return 1 ;;
    esac
  fi
  monitor_restore_needed=0
}

cleanup_schema_dry_run() {
  if [ -z "$schema_dry_run" ]; then return 0; fi
  case "$schema_dry_run" in
    "$BACKUP_DIR"/schema-dry-run-*)
      if ! rm -f -- "$schema_dry_run" "$schema_dry_run-wal" \
        "$schema_dry_run-shm" "$schema_dry_run-journal"; then
        return 1
      fi
      schema_dry_run=""
      ;;
    *)
      echo "Refusing to remove unexpected schema dry-run path." >&2
      return 1
      ;;
  esac
}

restore_updater() {
  if [ "$updater_installed" -ne 1 ]; then return 0; fi
  if [ -n "$updater_backup" ] && [ -f "$updater_backup" ]; then
    install -o root -g root -m 0755 "$updater_backup" "$UPDATER_PATH"
  else
    rm -f -- "$UPDATER_PATH"
  fi
}

cleanup() {
  local status=$? rollback_ok=1 inactive_status branch_commit unit
  trap - EXIT INT TERM

  if [ "$stop_attempted" -eq 1 ] && [ "$deployment_finalized" -ne 1 ]; then
    if [ "$checkout_mutated" -eq 1 ]; then
      set +e
      inactive_status=0
      for unit in "${managed_stop_units[@]}"; do
        timeout --foreground "${STOP_TIMEOUT_SECONDS}s" systemctl stop "$unit"
        if [ "$?" -ne 0 ]; then inactive_status=1; fi
      done
      for unit in "${managed_stop_units[@]}"; do
        wait_for_unit_inactive "$unit"
        if [ "$?" -ne 0 ]; then inactive_status=1; fi
      done
      set -e
      if [ "$inactive_status" -ne 0 ]; then rollback_ok=0; fi
      if [ "$rollback_ok" -eq 1 ]; then
        git -C "$APP_DIR" checkout --detach "$previous_commit" >/dev/null 2>&1 || rollback_ok=0
      fi
      if [ "$rollback_ok" -eq 1 ]; then
        branch_commit="$(git -C "$APP_DIR" rev-parse "refs/heads/$BRANCH")" || rollback_ok=0
        if [ "$rollback_ok" -eq 1 ] && [ "$branch_commit" = "$EXPECTED_COMMIT" ]; then
          git -C "$APP_DIR" update-ref "refs/heads/$BRANCH" "$previous_commit" "$EXPECTED_COMMIT" || rollback_ok=0
        elif [ "$rollback_ok" -eq 1 ] && [ "$branch_commit" != "$previous_commit" ]; then
          rollback_ok=0
        fi
      fi
      if [ "$rollback_ok" -eq 1 ]; then
        git -C "$APP_DIR" checkout "$BRANCH" >/dev/null 2>&1 || rollback_ok=0
      fi
      if [ "$rollback_ok" -eq 1 ]; then
        [ "$(git -C "$APP_DIR" rev-parse HEAD)" = "$previous_commit" ] || rollback_ok=0
        [ "$(git -C "$APP_DIR" rev-parse "refs/heads/$BRANCH")" = "$previous_commit" ] || rollback_ok=0
      fi
      if [ "$rollback_ok" -eq 1 ]; then
        env "PYTHONPATH=$APP_DIR/src" "$APP_DIR/.venv/bin/python" -m pip install -e "$APP_DIR" >/dev/null 2>&1 || rollback_ok=0
      fi
    fi
    if [ "$rollback_ok" -eq 1 ]; then restore_updater || rollback_ok=0; fi
    if [ "$rollback_ok" -eq 1 ]; then
      for unit in "${managed_start_units[@]}"; do
        systemctl start "$unit" || rollback_ok=0
      done
    fi
    if [ "$rollback_ok" -eq 1 ]; then
      for unit in "${managed_start_units[@]}"; do
        systemctl is-active --quiet "$unit" || rollback_ok=0
      done
    fi
  fi

  if [ "$monitor_managed" -eq 1 ] && [ "$monitor_restore_needed" -eq 1 ]; then
    if [ "$rollback_ok" -eq 1 ] && [ "$monitor_pin_normalized" -eq 1 ]; then
      sync_monitor_expected_head "$previous_commit" || rollback_ok=0
    fi
    if [ "$rollback_ok" -eq 1 ] && [ "$monitor_state_captured" -eq 1 ]; then
      restore_monitor_timer_state || rollback_ok=0
    fi
  fi

  if [ "$rollback_ok" -ne 1 ]; then
    echo "ROLLBACK FAILED; managed runtime units may remain stopped. Monitor state may also be incomplete." >&2
    exit 4
  fi

  if [ -n "$stage_dir" ] && [ -d "$stage_dir" ]; then
    if [ "$stage_registered" -eq 1 ]; then
      git -C "$APP_DIR" worktree remove --force "$stage_dir" >/dev/null 2>&1 || true
    else
      git -C "$APP_DIR" worktree remove --force "$stage_dir" >/dev/null 2>&1 || \
        rmdir -- "$stage_dir" >/dev/null 2>&1 || true
    fi
  fi
  cleanup_schema_dry_run || true
  [ -z "$updater_candidate" ] || rm -f -- "$updater_candidate" || true
  [ -z "$updater_backup" ] || rm -f -- "$updater_backup" || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cd "$APP_DIR"
if ! git fetch origin "$BRANCH"; then
  echo "Could not fetch the deployment branch." >&2
  exit 4
fi
if ! remote_head="$(git rev-parse FETCH_HEAD)"; then
  echo "Could not read the fetched deployment commit." >&2
  exit 4
fi
if [ "$remote_head" != "$EXPECTED_COMMIT" ]; then
  echo "Remote branch does not match EXPECTED_COMMIT." >&2
  exit 4
fi
if ! tracked_status="$(git status --porcelain --untracked-files=no)"; then
  echo "Could not verify the production tracked worktree." >&2
  exit 4
fi
if [ -n "$tracked_status" ]; then
  echo "Production tracked worktree must be clean before deployment." >&2
  exit 4
fi
current_branch="$(git symbolic-ref --quiet --short HEAD)" || {
  echo "Production checkout must be attached to the deployment branch." >&2
  exit 4
}
if ! branch_commit="$(git rev-parse "refs/heads/$BRANCH")"; then
  echo "Could not read the production branch rollback point." >&2
  exit 4
fi
if [ "$current_branch" != "$BRANCH" ] || [ "$branch_commit" != "$previous_commit" ]; then
  echo "Production branch is not an exact rollback point." >&2
  exit 4
fi

if ! stage_dir="$(mktemp -d "$STAGE_PARENT/telegram-kol-stage.XXXXXX")"; then
  echo "Could not create the candidate staging directory." >&2
  exit 4
fi
if ! chmod 0700 "$stage_dir"; then
  echo "Could not secure the candidate staging directory." >&2
  exit 4
fi
if ! git worktree add --detach "$stage_dir" "$EXPECTED_COMMIT" >/dev/null; then
  echo "Could not stage the exact candidate commit." >&2
  exit 4
fi
stage_registered=1
candidate_python=(env "PYTHONPATH=$stage_dir/src" "$APP_DIR/.venv/bin/python")

schema_changed=0
set +e
git -C "$APP_DIR" diff --quiet "$previous_commit" "$EXPECTED_COMMIT" -- \
  src/telegram_kol_research/models.py \
  src/telegram_kol_research/db.py \
  migrations
schema_diff_status=$?
set -e
case "$schema_diff_status" in
  0) ;;
  1) schema_changed=1 ;;
  *)
    echo "Could not classify schema paths." >&2
    exit 4
    ;;
esac

create_schema_backup_and_dry_run() {
  if ! install -d -m 0700 "$BACKUP_DIR"; then return 1; fi
  if ! cleanup_schema_dry_run; then return 1; fi
  schema_backup="$BACKUP_DIR/research-deployment-${EXPECTED_COMMIT}-$(date -u +%Y%m%dT%H%M%SZ).db"
  schema_dry_run="$BACKUP_DIR/schema-dry-run-${EXPECTED_COMMIT}-$$.db"
  if ! "${candidate_python[@]}" - schema "$DATABASE_PATH" "$schema_backup" "$schema_dry_run" <<'PY'
import os
from pathlib import Path
import sqlite3
import sys

_, mode, source_path, backup_path, dry_run_path = sys.argv
if mode != "schema":
    raise SystemExit(4)


def reserve(path: str) -> None:
    descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    os.close(descriptor)


def watermark(connection: sqlite3.Connection) -> tuple[int, int]:
    values: list[int] = []
    for table in ("raw_messages", "execution_events"):
        exists = connection.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
            (table,),
        ).fetchone()
        if exists is None:
            raise RuntimeError("required watermark table missing")
        value = connection.execute(
            f"SELECT COALESCE(MAX(id), 0) FROM {table}"
        ).fetchone()[0]
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise RuntimeError("invalid watermark")
        values.append(value)
    return values[0], values[1]


reserve(backup_path)
source_uri = Path(source_path).resolve().as_uri() + "?mode=ro"
source = sqlite3.connect(source_uri, uri=True)
backup = sqlite3.connect(backup_path)
try:
    source.execute("PRAGMA query_only=ON")
    if source.execute("PRAGMA query_only").fetchone() != (1,):
        raise RuntimeError("source is not query only")
    source.backup(backup)
finally:
    backup.close()
    source.close()

with sqlite3.connect(Path(backup_path).resolve().as_uri() + "?mode=ro", uri=True) as checked:
    checked.execute("PRAGMA query_only=ON")
    if checked.execute("PRAGMA quick_check").fetchone() != ("ok",):
        raise RuntimeError("schema backup quick_check failed")
    backup_watermark = watermark(checked)

reserve(dry_run_path)
backup = sqlite3.connect(Path(backup_path).resolve().as_uri() + "?mode=ro", uri=True)
dry_run = sqlite3.connect(dry_run_path)
try:
    backup.execute("PRAGMA query_only=ON")
    backup.backup(dry_run)
finally:
    dry_run.close()
    backup.close()

from telegram_kol_research.db import create_session_factory

factory = create_session_factory(dry_run_path)
factory.kw["bind"].dispose()
with sqlite3.connect(Path(dry_run_path).resolve().as_uri() + "?mode=ro", uri=True) as checked:
    checked.execute("PRAGMA query_only=ON")
    if checked.execute("PRAGMA quick_check").fetchone() != ("ok",):
        raise RuntimeError("migration dry-run quick_check failed")
    dry_run_watermark = watermark(checked)
if backup_watermark != dry_run_watermark:
    raise RuntimeError("migration dry-run watermark changed")
PY
  then
    return 1
  fi
}

if [ "$schema_changed" -eq 1 ]; then
  if ! create_schema_backup_and_dry_run; then
    echo "Schema backup or migration dry-run failed." >&2
    exit 4
  fi
fi

if ! classify_monitor_installation; then
  echo "Monitor installation is partial or invalid." >&2
  exit 4
fi
if [ "$monitor_managed" -eq 1 ]; then
  if ! record_monitor_timer_state; then
    echo "Could not record the monitor timer state." >&2
    exit 4
  fi
  if ! stop_monitor_for_deployment; then
    echo "Could not stop the monitor timer and oneshots." >&2
    exit 4
  fi
  if ! sync_monitor_expected_head "$previous_commit"; then
    echo "Could not normalize the monitor expected HEAD." >&2
    exit 4
  fi
  monitor_pin_normalized=1
fi

run_active_write_check() {
  local output status
  set +e
  output="$("${candidate_python[@]}" -m \
    telegram_kol_research.deployment_active_write_check "$DATABASE_PATH" 2>&1)"
  status=$?
  set -e
  case "$status" in
    0)
      if [ "$output" != "active_write_count=0" ]; then
        echo "Deployment active-write check failed." >&2
        exit 4
      fi
      ;;
    3)
      echo "Deployment refused: active exchange write." >&2
      exit 3
      ;;
    *)
      echo "Deployment active-write check failed." >&2
      exit 4
      ;;
  esac
}

stop_writer_service() {
  local stop_status=0 unit
  stop_attempted=1
  set +e
  for unit in "${managed_stop_units[@]}"; do
    timeout --foreground "${STOP_TIMEOUT_SECONDS}s" systemctl stop "$unit"
    if [ "$?" -ne 0 ]; then stop_status=1; fi
  done
  set -e
  if [ "$stop_status" -ne 0 ]; then
    echo "Exchange-writer service stop command failed." >&2
    exit 4
  fi
  for unit in "${managed_stop_units[@]}"; do
    if ! wait_for_unit_inactive "$unit"; then
      echo "Managed runtime unit did not reach an inactive state within the timeout: $unit" >&2
      exit 4
    fi
  done
}

start_managed_services() {
  local unit
  for unit in "${managed_start_units[@]}"; do
    if ! systemctl start "$unit"; then
      echo "Candidate runtime unit start failed: $unit" >&2
      return 1
    fi
  done
  for unit in "${managed_start_units[@]}"; do
    if ! systemctl is-active --quiet "$unit"; then
      echo "Candidate runtime unit did not become active: $unit" >&2
      return 1
    fi
  done
}

verify_http_health() {
  local attempt=1
  while [ "$attempt" -le 20 ]; do
    if curl -fsS --max-time 2 -o /dev/null \
      http://127.0.0.1:8000/api/trading-settings; then
      return 0
    fi
    if [ "$attempt" -eq 20 ]; then break; fi
    attempt=$((attempt + 1))
    sleep 0.5
  done
  return 1
}

run_active_write_check
stop_writer_service
run_active_write_check

checkout_mutated=1
if ! git checkout "$BRANCH"; then
  echo "Candidate checkout failed." >&2
  exit 4
fi
if ! git merge --ff-only "$EXPECTED_COMMIT"; then
  echo "Candidate fast-forward failed." >&2
  exit 4
fi
if [ "$(git rev-parse HEAD)" != "$EXPECTED_COMMIT" ]; then
  echo "Production checkout did not reach EXPECTED_COMMIT." >&2
  exit 4
fi
if ! env "PYTHONPATH=$APP_DIR/src" "$APP_DIR/.venv/bin/python" -m pip install -e "$APP_DIR"; then
  echo "Candidate package installation failed." >&2
  exit 4
fi
if ! start_managed_services; then
  exit 4
fi
if ! verify_http_health; then
  echo "Candidate HTTP health verification failed." >&2
  exit 4
fi

if [ -f "$UPDATER_PATH" ]; then
  if ! updater_backup="$(mktemp "$STAGE_PARENT/telegram-kol-updater-backup.XXXXXX")"; then
    echo "Could not create the durable-updater backup." >&2
    exit 4
  fi
  if ! cp -p -- "$UPDATER_PATH" "$updater_backup"; then
    echo "Could not back up the durable updater." >&2
    exit 4
  fi
fi
updater_candidate="${UPDATER_PATH}.candidate.$$"
if ! install -o root -g root -m 0755 "$stage_dir/deploy/telegram-kol-update" "$updater_candidate"; then
  echo "Could not stage the durable updater." >&2
  exit 4
fi
updater_installed=1
if ! mv -f -- "$updater_candidate" "$UPDATER_PATH"; then
  echo "Could not install the durable updater." >&2
  exit 4
fi
updater_candidate=""

if ! git -C "$APP_DIR" worktree remove --force "$stage_dir" >/dev/null; then
  echo "Could not remove the candidate worktree." >&2
  exit 4
fi
stage_dir=""
stage_registered=0
if ! cleanup_schema_dry_run; then
  echo "Could not remove the disposable schema copy." >&2
  exit 4
fi
if [ "$monitor_managed" -eq 1 ]; then
  if ! sync_monitor_expected_head "$EXPECTED_COMMIT"; then
    echo "Could not advance the monitor expected HEAD." >&2
    exit 4
  fi
  if ! restore_monitor_timer_state; then
    echo "Could not restore the monitor timer state." >&2
    exit 4
  fi
fi
deployment_finalized=1
stop_attempted=0
checkout_mutated=0
updater_installed=0
trap - EXIT INT TERM
if [ -n "$updater_backup" ]; then
  rm -f -- "$updater_backup" || true
fi
updater_backup=""
