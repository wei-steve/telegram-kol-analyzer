#!/usr/bin/python3
"""Race-safe ACL restoration for the exact Runtime Agent SQLite files."""

from __future__ import annotations

import errno
import grp
import os
import pwd
import stat
import subprocess
import sys
from pathlib import Path

from telegram_kol_research.contract_cache_permissions import (
    converge_contract_cache_permissions,
)


AGENT_USER = "telegram-kol-agent"
WORKER_USER = "telegram-kol-worker"
SHARED_RUNTIME_GROUP = "telegram-kol-runtime"
SHARED_RUNTIME_USERS = (
    "telegram-kol-ingest",
    "telegram-kol-worker",
    "telegram-kol-web",
)
DATABASE_PATH = "/opt/telegram-kol-analyzer/data/research.db"
SQLITE_PATHS = (
    DATABASE_PATH,
    f"{DATABASE_PATH}-wal",
    f"{DATABASE_PATH}-shm",
    f"{DATABASE_PATH}-journal",
)
SQLITE_NAMES = frozenset(os.path.basename(path) for path in SQLITE_PATHS)
WORKER_OWNED_RUNTIME_FILES = frozenset({"deepcoin_contract_specs_cache.json"})
ROOT_SHARED_RUNTIME_FILES = frozenset(
    {
        "telegram.session",
        "telegram.session-journal",
        "telegram.session-shm",
        "telegram.session-wal",
        "telegram.session.lock",
    }
)
REVIEWED_READABLE_DATA_DIRECTORIES = frozenset({"logs", "media", "web_cache"})
DENIED_DATA_DIRECTORIES = frozenset(
    {"backups", "deepcoin_field_probe", "session_backups"}
)
REVIEWED_DATA_DIRECTORIES = (
    REVIEWED_READABLE_DATA_DIRECTORIES | DENIED_DATA_DIRECTORIES
)


def _open_regular_nofollow(path: str, *, optional: bool) -> int | None:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        if optional:
            return None
        raise
    except OSError as exc:
        if optional and exc.errno == errno.ENOENT:
            return None
        raise
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        os.close(fd)
        raise RuntimeError("SQLite ACL target is not a single-link regular file")
    return fd


def _open_regular_nofollow_at(directory_fd: int, name: str) -> int:
    if not name or name in {".", ".."} or "/" in name:
        raise RuntimeError("invalid production data filename")
    fd = os.open(
        name,
        os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
        dir_fd=directory_fd,
    )
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        os.close(fd)
        raise RuntimeError("production data target is not a single-link regular file")
    return fd


def _set_agent_acl_fd(fd: int, permission: str) -> None:
    subprocess.run(
        [
            "/usr/bin/setfacl",
            "-m",
            f"u:{AGENT_USER}:{permission}",
            "--",
            f"/proc/self/fd/{fd}",
        ],
        check=True,
        close_fds=True,
        pass_fds=(fd,),
        env={"PATH": "/usr/bin:/bin", "LANG": "C"},
    )


def _set_shared_runtime_acl_fd(fd: int) -> None:
    runtime_gid = grp.getgrnam(SHARED_RUNTIME_GROUP).gr_gid
    os.fchown(fd, 0, runtime_gid)
    os.fchmod(fd, 0o660)
    subprocess.run(
        [
            "/usr/bin/setfacl",
            "-m",
            f"u:{AGENT_USER}:---,g::rw-,m::rw-",
            "--",
            f"/proc/self/fd/{fd}",
        ],
        check=True,
        close_fds=True,
        pass_fds=(fd,),
        env={"PATH": "/usr/bin:/bin", "LANG": "C"},
    )


def _trusted_shared_runtime_owner_uids(trusted_owner_uid: int) -> frozenset[int]:
    owner_uids = {trusted_owner_uid}
    for username in SHARED_RUNTIME_USERS:
        try:
            owner_uids.add(pwd.getpwnam(username).pw_uid)
        except KeyError:
            continue
    return frozenset(owner_uids)


def _verify_reviewed_directory_nofollow_at(
    directory_fd: int,
    name: str,
    *,
    trusted_owner_uid: int,
    deny_agent: bool,
) -> None:
    fd = os.open(
        name,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
        dir_fd=directory_fd,
    )
    try:
        metadata = os.fstat(fd)
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != trusted_owner_uid:
            raise RuntimeError("reviewed production data directory is not trusted")
        if deny_agent:
            os.fchmod(fd, metadata.st_mode & ~0o077)
            _set_agent_acl_fd(fd, "---")
    finally:
        os.close(fd)


def _sanitize_non_database_files(*, trusted_owner_uid: int = 0) -> None:
    directory_fd = os.open(
        os.path.dirname(DATABASE_PATH),
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC,
    )
    try:
        for name in os.listdir(directory_fd):
            if name in SQLITE_NAMES:
                continue
            if name in REVIEWED_DATA_DIRECTORIES:
                _verify_reviewed_directory_nofollow_at(
                    directory_fd,
                    name,
                    trusted_owner_uid=trusted_owner_uid,
                    deny_agent=name in DENIED_DATA_DIRECTORIES,
                )
                continue
            if name in WORKER_OWNED_RUNTIME_FILES:
                worker_uid = pwd.getpwnam(WORKER_USER).pw_uid
                runtime_gid = grp.getgrnam(SHARED_RUNTIME_GROUP).gr_gid
                converge_contract_cache_permissions(
                    Path(os.path.dirname(DATABASE_PATH)) / name,
                    worker_uid=worker_uid,
                    runtime_gid=runtime_gid,
                    agent_user=AGENT_USER,
                )
                continue
            try:
                fd = _open_regular_nofollow_at(directory_fd, name)
            except FileNotFoundError:
                continue
            try:
                metadata = os.fstat(fd)
                if name in ROOT_SHARED_RUNTIME_FILES:
                    if metadata.st_uid not in _trusted_shared_runtime_owner_uids(
                        trusted_owner_uid
                    ):
                        raise RuntimeError(
                            "shared runtime data has an unexpected owner"
                        )
                    _set_shared_runtime_acl_fd(fd)
                    continue
                if metadata.st_uid != trusted_owner_uid:
                    raise RuntimeError("non-database production data is not root-owned")
                os.fchmod(fd, metadata.st_mode & ~0o077)
                _set_agent_acl_fd(fd, "---")
            finally:
                os.close(fd)
    finally:
        os.close(directory_fd)


def main() -> int:
    if os.geteuid() != 0 or len(sys.argv) not in {1, 2}:
        raise RuntimeError("SQLite ACL preparation requires root")
    agent_uid = pwd.getpwnam(AGENT_USER).pw_uid
    if len(sys.argv) == 2:
        if sys.argv[1] != "--sanitize-non-db":
            raise RuntimeError("unsupported SQLite ACL preparation mode")
        _sanitize_non_database_files()
        return 0
    for index, sqlite_path in enumerate(SQLITE_PATHS):
        fd = _open_regular_nofollow(sqlite_path, optional=index != 0)
        if fd is None:
            continue
        try:
            metadata = os.fstat(fd)
            if metadata.st_uid not in {0, agent_uid}:
                raise RuntimeError("SQLite ACL target has an unexpected owner")
            _set_agent_acl_fd(fd, "rw-")
        finally:
            os.close(fd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
