#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" -ne 0 || "$#" -ne 0 ]]; then
  echo "Runtime Agent database ACL preparation requires root and no arguments." >&2
  exit 1
fi

AGENT_USER="telegram-kol-agent"
DATABASE_PATH="/opt/telegram-kol-analyzer/data/research.db"

if ! id "$AGENT_USER" >/dev/null 2>&1 || [[ ! -f "$DATABASE_PATH" ]]; then
  echo "Runtime Agent identity or production database is missing." >&2
  exit 1
fi

# The root main service may recreate these after a clean shutdown or reboot.
# Reapply only the exact SQLite allowlist before every Agent start/restart.
for sqlite_file in \
  "$DATABASE_PATH" \
  "$DATABASE_PATH-wal" \
  "$DATABASE_PATH-shm" \
  "$DATABASE_PATH-journal"
do
  if [[ -e "$sqlite_file" ]]; then
    setfacl -m "u:$AGENT_USER:rw-" "$sqlite_file"
  fi
done

if ! runuser -u "$AGENT_USER" -- test -w "$DATABASE_PATH"; then
  echo "Runtime Agent cannot update the reviewed SQLite ledger." >&2
  exit 1
fi
