[Unit]
Description=Telegram KOL low-frequency production monitor audit v2
Requires=telegram-kol-monitor-db-stage@audit.service
After=telegram-kol-monitor-db-stage@audit.service

[Service]
Type=oneshot
User=telegram-kol-monitor-sentinel
Group=telegram-kol-monitor-sentinel
UMask=0077
WorkingDirectory=/var/cache/telegram-kol-monitor-v2/audit
ExecStart=/opt/telegram-kol-monitor-v2/current/.venv/bin/telegram-kol-research run-production-monitor-audit --state-path /var/lib/telegram-kol-monitor-v2/sentinel/sentinel-v2.json --database-path /var/cache/telegram-kol-monitor-v2/audit/research-snapshot.db --scratch-root /var/cache/telegram-kol-monitor-v2/audit

AmbientCapabilities=
CapabilityBoundingSet=
InaccessiblePaths=-/run/dbus/system_bus_socket -/run/systemd/private
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateMounts=true
PrivateNetwork=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@mount @network-io @privileged
TemporaryFileSystem=/opt/telegram-kol-analyzer:ro
ReadOnlyPaths=/var/cache/telegram-kol-monitor-v2/audit/research-snapshot.db
ReadWritePaths=/var/lib/telegram-kol-monitor-v2/sentinel
ReadWritePaths=/var/cache/telegram-kol-monitor-v2/audit
