[Unit]
Description=Telegram KOL on-call Codex runner (read-only diagnosis, allowlist namespace)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/telegram-kol-oncall.env

[Service]
Type=simple
Restart=always
RestartSec=15
# Codex is logged in under root and its credentials live in /root/.codex, so
# this unit runs as root -- and then gives that root nothing. It has no
# capabilities, cannot gain any, and sees a filesystem built from an allowlist
# rather than one with holes punched in it: the production database, every
# environment file, the settings and data directories, the git history and
# every other project on this machine are simply not present in its
# namespace. Codex's own read-only sandbox does not stop it from *reading*,
# so hiding is the only control that actually works.
User=root
Group=root
# The watcher writes each request as telegram-kol-oncall:telegram-kol-oncall
# 0660 inside a 0770 directory. With the capability set cut down to
# CAP_SETFCAP, uid 0 has no DAC override, so without this group the runner is
# "other" and cannot read a single request -- which is what happened in
# production on 2026-09-21: every real case went unanswered and the watcher
# recorded it as a timeout. The acceptance run had only tested the other
# direction (runner writes, watcher reads).
SupplementaryGroups=telegram-kol-oncall
UMask=0077
WorkingDirectory=/var/lib/telegram-kol-oncall/codex-spool
EnvironmentFile=/etc/telegram-kol-oncall.env
ExecStartPre=+/bin/mkdir -p /var/lib/telegram-kol-oncall/codex-spool
ExecStartPre=+/bin/chown root:telegram-kol-oncall /var/lib/telegram-kol-oncall/codex-spool
ExecStartPre=+/bin/chmod 2770 /var/lib/telegram-kol-oncall/codex-spool
ExecStart=/opt/telegram-kol-analyzer/.venv/bin/python -B -m telegram_kol_research.oncall_codex_runner --spool /var/lib/telegram-kol-oncall/codex-spool

AmbientCapabilities=
# One capability, not none: codex runs every command through its bundled
# bubblewrap, and since Linux 5.12 mapping uid 0 into a user namespace needs
# CAP_SETFCAP in the parent. With an empty set every command died with "bwrap:
# setting up uid map: Operation not permitted" (bisected on the server with
# `codex sandbox id`, 2026-09-20; SETUID/SETGID/SYS_ADMIN were neither needed nor
# sufficient). Under NoNewPrivileges a file capability confers nothing on exec,
# and the only writable places here are the spool and /root/.codex.
CapabilityBoundingSet=CAP_SETFCAP
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# Other uid-0 processes' /proc/<pid>/environ is readable by uid 0 without any
# capability; keep the process list down to this unit's own.
ProtectProc=invisible
# Not ProcSubset=pid: codex runs every command through its bundled bubblewrap,
# which needs /proc/sys/kernel/overflowuid. With /proc/sys hidden every command
# failed, Codex could read nothing, and the smoke test's "write was blocked"
# step passed for the wrong reason (server acceptance, 2026-09-20).

# The allowlist. Each TemporaryFileSystem replaces a whole tree with an empty
# read-only one; the BindReadOnlyPaths below then put back the few things that
# have to be visible. Anything not named here does not exist for this process.
TemporaryFileSystem=/etc:ro
# Server acceptance, 2026-09-20: /run holds docker.sock, containerd, the systemd
# private socket and the system bus, every one of them connectable by uid 0 even
# with an empty capability set -- docker.sock alone is the whole host. /www is a
# non-standard top-level directory on this machine. resolv.conf is a plain file
# here, so hiding /run does not take DNS with it.
TemporaryFileSystem=/run:ro
TemporaryFileSystem=/www:ro
# Hidden top-level directories found by the probe on this host (an SSH
# manager's database lives in the first). `TemporaryFileSystem=/:ro` would make
# this list unnecessary, but on this systemd 255 it did not take effect -- the
# probe saw the whole machine -- so the overlays stay explicit and the probe
# fails on any top-level entry it does not know.
TemporaryFileSystem=/.__gmssh:ro
TemporaryFileSystem=/.Recycle_bin:ro
TemporaryFileSystem=/opt:ro
TemporaryFileSystem=/var:ro
TemporaryFileSystem=/srv:ro
TemporaryFileSystem=/data:ro
TemporaryFileSystem=/mnt:ro
TemporaryFileSystem=/media:ro

# TLS trust and name resolution, so the HTTPS call to OpenAI can be made.
# CA bundles only: /etc/pki/tls/private and /etc/ssl/private hold private keys.
BindReadOnlyPaths=-/etc/ssl/certs
BindReadOnlyPaths=-/etc/pki/ca-trust
BindReadOnlyPaths=-/etc/pki/tls/certs
BindReadOnlyPaths=-/etc/pki/tls/cert.pem
BindReadOnlyPaths=-/etc/ca-certificates
BindReadOnlyPaths=-/etc/resolv.conf
BindReadOnlyPaths=-/etc/hosts
BindReadOnlyPaths=-/etc/nsswitch.conf
BindReadOnlyPaths=-/etc/passwd
BindReadOnlyPaths=-/etc/group
BindReadOnlyPaths=-/etc/localtime
# The deployed source, which is what Codex reads to explain a reason code, and
# the interpreter that runs this module. Neither is writable.
BindReadOnlyPaths=/opt/telegram-kol-analyzer/src
BindReadOnlyPaths=/opt/telegram-kol-analyzer/.venv
# Writable: the credential store (the token refreshes itself) and the spool.
BindPaths=/root/.codex
BindPaths=/var/lib/telegram-kol-oncall/codex-spool

# Deliberately NOT set: RestrictNamespaces, SystemCallFilter, PrivateUsers,
# MemoryDenyWriteExecute. This kernel (6.6.92) has no landlock, so codex's own
# read-only sandbox falls back to user namespaces and seccomp; those four
# options are exactly what would stop it from starting. Whether any of them
# can be added is a question for the sandbox probe on the server, not a guess
# made here.

[Install]
WantedBy=multi-user.target
